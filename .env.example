# Comma-separated public hostnames users paste into BitChord addon URL.
# Example after Render deploy: avinash-dual-lossless.onrender.com
BITCHORD_HOSTS=your-service.onrender.com
PORT=3000
# Keep "log" for initial deployment, then change to "enforce" after testing.
BITCHORD_AUTH_MODE=log
# Optional directory containing your own audio files (FLAC, MP3, M4A, OGG, WAV).
MUSIC_DIR=./music

# Public origin including https://; set this to your actual Render URL after deployment.
PUBLIC_BASE_URL=https://your-service.onrender.com
# Required: use a long random value; never commit the real value.
MEDIA_SECRET=replace-with-a-long-random-secret
